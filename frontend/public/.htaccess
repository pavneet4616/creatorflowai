<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect to remove trailing slashes (Next.js static export preference)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]

  # If an existing asset or directory is requested, serve it
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
  RewriteRule ^ - [L]

  # Try to serve the corresponding .html file for the requested route
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Fallback to index.html for client-side routing (if applicable)
  RewriteRule ^ index.html [L]
</IfModule>
